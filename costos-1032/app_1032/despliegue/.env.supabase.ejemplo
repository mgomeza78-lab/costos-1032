# =====================================================================
#  Variables de entorno para conectar el aplicativo a Supabase (plan free).
#  Copie este archivo como ".env", reemplace los valores y cárguelo antes de
#  arrancar el aplicativo. NO suba este archivo con las claves a ningún repositorio.
# =====================================================================

# --- Entorno ---
APP_ENV=prod
# Clave de sesión: una cadena larga y aleatoria (p. ej. 40+ caracteres).
APP_SECRET_KEY=PONGA_AQUI_UNA_CLAVE_LARGA_Y_ALEATORIA

# --- Conexión a Supabase ---
# En Supabase: Settings → Database → Connection string. Use la cadena del
# "Session pooler" (IPv4) o "Direct connection". De ahí saque el host, el puerto
# y la contraseña del rol 'postgres' que definió al crear el proyecto.
DB_HOST=db.XXXXXXXXXXXX.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_SSLMODE=require

# Contraseña del rol 'postgres' de Supabase (la del proyecto).
DB_OWNER_PASSWORD=LA_CONTRASENA_DE_POSTGRES_DE_SUPABASE

# Contraseña del rol de aplicación 'app_user' = la MISMA que puso en
# supabase_setup.sql (línea "ALTER ROLE app_user ... PASSWORD '...'").
DB_APP_PASSWORD=LA_CLAVE_QUE_PUSO_PARA_app_user

# Clave de los usuarios de ejemplo de la semilla (para el primer ingreso).
SEED_PASSWORD=Cambiar2026*

# ---------------------------------------------------------------------
# ALTERNATIVA (más robusta si el rol app_user no conecta por el pooler):
# pegue las cadenas COMPLETAS que da Supabase, cambiando el prefijo a
# "postgresql+psycopg://" y agregando "?sslmode=require". Para la de aplicación,
# reemplace el rol 'postgres' por 'app_user' (conexión directa) o
# 'postgres.<ref>' por 'app_user.<ref>' (pooler), y su contraseña.
# Si define estas dos, tienen prioridad sobre las variables de arriba.
# ---------------------------------------------------------------------
# DB_OWNER_URL=postgresql+psycopg://postgres:CLAVE@db.XXXX.supabase.co:5432/postgres?sslmode=require
# DB_APP_URL=postgresql+psycopg://app_user:CLAVE_APP@db.XXXX.supabase.co:5432/postgres?sslmode=require
